<body>

  <!-- HERO con banner de fondo -->
  <header class="hero" id="home">
    <nav class="navbar">
      <div class="logo">Carlos</div>
      <ul class="nav-links">
        <li><a href="#home" class="active">Inicio</a></li>
        <li><a href="#about">Sobre mí</a></li>
        <li><a href="#experience">Experiencia</a></li>
        <li><a href="#projects">Proyectos</a></li>
        <li><a href="#research">Investigación</a></li>
        <li><a href="#blog">Blog</a></li>
        <li><a href="#contact">Contacto</a></li>
      </ul>
    </nav>

    <div class="hero-text">
      <h1>Bienvenido a Mi Portafolio</h1>
      <p>Hola, soy Carlos, apasionado por la economía, la tecnología y la innovación.</p>
      <a href="#contact" class="btn">Contáctame</a>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="container">

    <!-- SOBRE MÍ -->
    <section id="about">
      <h2>Sobre mí</h2>
      <p>
        Soy estudiante de secundaria con foco en economía y emprendimiento.  
        Especializado en microeconomía, desarrollo web y proyectos innovadores.  
        En mi tiempo libre disfruto del tenis y de lecturas de filosofía.
      </p>
    </section>

    <!-- EXPERIENCIA -->
    <section id="experience">
      <h2>Experiencia</h2>
      <div class="card">
        <h3>Participante Harvard SSP</h3>
        <span>Jun. 2025 – Presente</span>
        <p>
          Estudiante en Principles of Economics: Micro y Macro  
          en Harvard Summer School (programa intensivo presencial).
        </p>
      </div>
      <!-- duplica más .card si necesitas -->
    </section>

    <!-- PROYECTOS -->
    <section id="projects">
      <h2>Proyectos</h2>
      <div class="card">
        <h3>Flashcards AI</h3>
        <p>
          Sistema de flashcards con Python y API de lenguaje natural  
          para generación y evaluación de preguntas.
        </p>
      </div>
    </section>

    <!-- INVESTIGACIÓN -->
    <section id="research">
      <h2>Investigación</h2>
      <p>
        Estudio de estrategias de inflación y políticas monetarias aplicadas  
        al caso peruano (1996–2024).
      </p>
    </section>

    <!-- BLOG -->
    <section id="blog">
      <h2>Blog</h2>
      <p>Próximamente compartiré artículos sobre economía, inversión y tecnología.</p>
    </section>

    <!-- CONTACTO -->
    <section id="contact">
      <h2>Contacto</h2>
      <p>Email: <a href="mailto:carlos@ejemplo.com">carlos@ejemplo.com</a></p>
    </section>

  </main>

  <!-- FOOTER -->
  <footer>
    <p>&copy; 2025 Carlos. Todos los derechos reservados.</p>
    <div class="socials">
      <a href="#"><img src="images/twitter.svg" alt="Twitter"></a>
      <!-- añade más iconos si quieres -->
    </div>
  </footer>

